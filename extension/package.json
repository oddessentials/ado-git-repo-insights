{
  "name": "ado-git-repo-insights-extension",
  "version": "1.0.0",
  "description": "ADO Git Repo Insights Extension UI",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "test:types": "tsc --noEmit --project tsconfig.type-tests.json",
    "test:smoke": "playwright test",
    "serve:docs": "serve ../docs -l 3000 --no-clipboard",
    "serve:broken": "serve ./tests/fixtures/broken-docs -l 3001 --no-clipboard",
    "clean": "python ../scripts/clean_ephemeral.py --yes --category extension",
    "clean:ui": "python ../scripts/clean_ephemeral.py --yes --id extension-dist-ui",
    "build:ui": "node scripts/bundle-ui.mjs",
    "build": "pnpm run build:tsc && pnpm run build:ui",
    "lint": "eslint ui/ scripts/ tasks/_shared/ --max-warnings=0",
    "lint:tests": "eslint tests/ --max-warnings=0",
    "lint:all": "eslint ui/ scripts/ tasks/_shared/ tests/ --max-warnings=0",
    "depcruise": "npx depcruise ui --config .dependency-cruiser.cjs",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --ignore-path ../.prettierignore",
    "pretest": "pnpm run build:ui",
    "test": "pnpm run test:unit",
    "test:unit": "jest --testPathIgnorePatterns=python-integration --testPathIgnorePatterns=vsix-artifact-inspection",
    "test:scalability": "jest --testPathPatterns=scalability",
    "test:all": "jest --testPathIgnorePatterns=vsix-artifact-inspection",
    "test:watch": "jest --watch --testPathIgnorePatterns=python-integration",
    "test:coverage": "jest --ci --runInBand --coverage --reporters=default --reporters=jest-junit --testPathIgnorePatterns=vsix-artifact-inspection",
    "test:partial-branches": "python ../scripts/check_partial_branches.py --lcov coverage/lcov.info --baseline ../.coverage-partial-branches-baseline.json",
    "test:schema-parity": "python ../scripts/check_pr_record_schema_parity.py",
    "pretest:ci": "pnpm run build:ui",
    "pretest:coverage": "pnpm run build:ui",
    "test:ci": "pnpm run build:check && pnpm run lint:tests && pnpm run build:check-tests && pnpm run test:config-parity && pnpm run format:check && pnpm run test:types && pnpm run test:coverage && pnpm run test:partial-branches && pnpm run test:schema-parity && pnpm run test:smoke",
    "test:vsix": "jest --ci --testPathPatterns vsix-artifact-inspection",
    "perf:update-baseline": "npx ts-node scripts/update-perf-baseline.ts",
    "postinstall": "pnpm exec playwright install chromium",
    "stage:tasks": "node scripts/stage-task-deps.mjs",
    "clean:tasks": "node scripts/clean-task-deps.mjs",
    "package:vsix": "pnpm run build && pnpm run stage:tasks && pnpm exec tfx extension create --manifest-globs vss-extension.json",
    "package:vsix:dev": "pnpm run build && pnpm run stage:tasks && node scripts/package-dev-vsix.mjs",
    "build:check-tests": "tsc --noEmit --project tsconfig.test.json",
    "test:config-parity": "node scripts/check-test-config-parity.mjs",
    "hooks:precommit": "cd .. && python scripts/run_repo_hook.py pre-commit",
    "hooks:prepush": "cd .. && python scripts/run_repo_hook.py pre-push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@playwright/test": "1.59.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "dependency-cruiser": "^17.3.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-security": "^4.0.0",
    "expect-type": "^1.3.0",
    "glob": "^13.0.6",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.8.3",
    "serve": "14.2.6",
    "tfx-cli": "0.23.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "test-results.xml"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.270.0",
    "azure-devops-extension-sdk": "^4.2.0"
  }
}
