#!/bin/sh
set -eu

if command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
    exec py -3 scripts/run_repo_hook.py pre-commit
elif command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
    exec python3 scripts/run_repo_hook.py pre-commit
elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
    exec python scripts/run_repo_hook.py pre-commit
else
    echo "[pre-commit] Python is required to run repository hooks."
    exit 1
fi
