#!/bin/sh
set -eu

# Source the venv resolver: prepends .venv/{bin,Scripts} to PATH and exports
# VENV_PYTHON. Fails fast with an actionable setup message if the venv is
# missing — replaces the prior cascade through `py -3 / python3 / python`
# which silently picked up whatever interpreter the developer's shell had.
. ./.husky/_python_path.sh

exec "$VENV_PYTHON" scripts/run_repo_hook.py pre-commit
