#!/bin/sh
set -eu

entire hooks git pre-push "$1" || true

# Source the venv resolver: prepends .venv/{bin,Scripts} to PATH and exports
# VENV_PYTHON. Fails fast with an actionable setup message if the venv is
# missing — `pre-commit run` underneath spawns `language: system` hooks that
# resolve bare `python` through PATH, so making the resolver canonical here
# is the single source of truth for interpreter choice across the entire
# hook chain (the prior cascade through `py -3 / python3 / python` recreated
# the platform skew this helper was written to eliminate).
. ./.husky/_python_path.sh

exec "$VENV_PYTHON" scripts/run_repo_hook.py pre-push
