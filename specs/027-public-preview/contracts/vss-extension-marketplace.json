{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "vss-extension-marketplace-fields",
    "title": "VS Marketplace Extension Metadata Contract",
    "description": "Defines the required marketplace metadata fields for public listing. These fields are additive to the existing vss-extension.json manifest.",
    "type": "object",
    "required": [
        "galleryFlags",
        "description",
        "categories",
        "tags",
        "galleryBanner",
        "screenshots",
        "links",
        "badges",
        "CustomerQnASupport"
    ],
    "properties": {
        "galleryFlags": {
            "type": "array",
            "items": { "type": "string", "enum": ["Public", "Preview", "Paid", "Free"] },
            "minItems": 1,
            "description": "Must contain 'Public' for marketplace visibility. 'Preview' signals pre-GA status."
        },
        "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Short description shown in search results. Must contain 'optional' qualifier for ML/AI claims per FR-013.",
            "pattern": "(?i)(optional|configurable|add-on)"
        },
        "categories": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": ["Azure Repos", "Azure Boards", "Azure Pipelines", "Azure Test Plans", "Azure Artifacts"]
            },
            "minItems": 1,
            "description": "Must include both Azure Pipelines and Azure Repos for dual discoverability."
        },
        "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 8,
            "maxItems": 20,
            "description": "Search keywords. Minimum 8 per FR-004."
        },
        "galleryBanner": {
            "type": "object",
            "required": ["color", "theme"],
            "properties": {
                "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Hex color for banner background."
                },
                "theme": {
                    "type": "string",
                    "enum": ["dark", "light"],
                    "description": "Text/icon color scheme for legibility."
                }
            }
        },
        "screenshots": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "pattern": "^screenshots/.+\\.png$" }
                }
            },
            "minItems": 3,
            "maxItems": 8,
            "description": "Screenshot file paths relative to extension root. Auto-bundled by tfx-cli."
        },
        "links": {
            "type": "object",
            "required": ["home", "repository", "issues", "support", "license", "getstarted"],
            "properties": {
                "home":       { "$ref": "#/$defs/linkEntry" },
                "repository": { "$ref": "#/$defs/linkEntry" },
                "issues":     { "$ref": "#/$defs/linkEntry" },
                "support":    { "$ref": "#/$defs/linkEntry" },
                "license":    { "$ref": "#/$defs/linkEntry" },
                "getstarted": { "$ref": "#/$defs/linkEntry" }
            }
        },
        "badges": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["href", "uri", "description"],
                "properties": {
                    "href":        { "type": "string", "format": "uri" },
                    "uri":         { "type": "string", "format": "uri", "pattern": "^https://img\\.shields\\.io/" },
                    "description": { "type": "string" }
                }
            },
            "minItems": 2,
            "description": "Badge images. URI must be from img.shields.io (marketplace allowlisted domain)."
        },
        "CustomerQnASupport": {
            "type": "object",
            "required": ["enableqna", "url"],
            "properties": {
                "enableqna": { "type": "boolean", "const": true },
                "url":       { "type": "string", "format": "uri" }
            },
            "description": "Redirects marketplace Q&A to external URL (GitHub Issues)."
        }
    },
    "$defs": {
        "linkEntry": {
            "type": "object",
            "required": ["uri"],
            "properties": {
                "uri": { "type": "string", "format": "uri" }
            }
        }
    }
}
